# Goal — trigger a full inspection sequence
string object_id    # optional label for logging (e.g. "sample_01")
---
# Result — final verdict after all poses
string verdict      # PASS | FAIL
int32 pass_votes    # number of frames that voted PASS
int32 fail_votes    # number of frames that voted FAIL
---
# Feedback — real-time progress during the sequence
string state        # current state: MOVING_TO_Px | COLLECTING_Px | CLASSIFYING | SORTING | etc.
float32 progress    # 0.0 – 1.0
int32 pass_votes    # running vote count
int32 fail_votes
